android_app {
    name: "OdinParts",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "org.lineageos.settings.resources",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "odinparts.rc",
    ],
}

prebuilt_etc {
    name: "odinparts.rc",
    src: "configs/init/odinparts.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
